# ═════════════════════════════════════════════════════
# KHANHOS AI — Environment Variables
# Copy file này thành .env và điền giá trị.
# KHÔNG BAO GIỜ commit .env vào git!
# ═════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────
# Sandbox/dev: SQLite. Production: PostgreSQL (Supabase/Neon/Vercel Postgres)
# Khi chuyển sang PostgreSQL: chạy ./scripts/switch-to-postgres.sh (xem README)
# SQLite:      file:./db/custom.db
# PostgreSQL:  postgresql://user:password@localhost:5432/khanhos?schema=public
DATABASE_URL="file:./db/custom.db"

# ── App ───────────────────────────────────────────────
# Base URL dùng để sinh link reset mật khẩu (đúng domain production)
APP_URL="http://localhost:3000"

# ── Bộ máy chat ────────────────────────────────────────
# KHÔNG cần API key AI nào — engine trả lời 100% cục bộ
# (intent + tri thức từ data/chatbot/*.json, xem data/chatbot/README.md).
#
# HỆ AI CỤC BỘ (src/ai/): nếu có model runtime local (Ollama/llama.cpp),
# câu hỏi ngoài tri thức sẽ được MODEL THẬT suy luận — vẫn không API ngoài.
# Bật runtime:  bash scripts/setup-ollama.sh
#   (tải Ollama + pull qwen2.5:0.5b + daemon hoá + probe sức khoẻ)
#
# AI_RUNTIME: auto | ollama | openai-compat | cerebras | openrouter | none (mặc định auto)
# AI_RUNTIME="auto"
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OPENAI_COMPAT_BASE_URL="http://127.0.0.1:8080"   # llama.cpp / vLLM / LM Studio local
# AI_MODEL="qwen2.5:0.5b"                           # model mặc định của runtime
# AI_NUM_CTX="4096"                                  # context window mặc định
# AI_MAX_CONTEXT_TOKENS="3000"                       # ngân sách ngữ cảnh mỗi lượt chat
# Bảo mật: runtime chỉ chấp nhận loopback — AI_ALLOW_REMOTE="true" để mở (tự chịu trách nhiệm)
# AI_ENABLE_UNSAFE_TOOLS="true"  # bật tool ghi file/terminal (MẶC ĐỊNH TẮT)

# ── Cerebras Cloud ───────────────────────────────────
# Đặt AI_RUNTIME="cerebras" để dùng Cerebras thay cho model local.
# API key chỉ ở server, tuyệt đối không đưa vào frontend.
# CEREBRAS_BASE_URL="https://api.cerebras.ai"
# CEREBRAS_API_KEY=""
# AI_MODEL="llama-3.3-70b"

# ── OpenRouter ───────────────────────────────────────
# Đặt AI_RUNTIME="openrouter" để dùng model qua OpenRouter.
# Ví dụ model: meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_BASE_URL="https://openrouter.ai/api"
# OPENROUTER_API_KEY=""

# ── TÙY CHỌN: dùng API AI bên ngoài (OpenAI-compatible) ──
# Mặc định hệ thống chạy 100% local (không cần key). Nếu chủ sở hữu CÓ key và
# muốn bot mạnh hơn nữa (model đám mây thay model local), mở khoá 3 bước:
#   1. AI_ALLOW_REMOTE="true"                 (chấp nhận endpoint ngoài máy)
#   2. AI_RUNTIME="openai-compat"             (dùng adapter OpenAI-compatible)
#   3. OPENAI_COMPAT_BASE_URL + OPENAI_COMPAT_API_KEY + AI_MODEL bên dưới
# Ví dụ OpenRouter (rất nhiều model miễn phí):
#   OPENAI_COMPAT_BASE_URL="https://openrouter.ai/api/v1"
#   OPENAI_COMPAT_API_KEY="sk-or-v1-..."
#   AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# Ví dụ Groq (miễn phí, nhanh):
#   OPENAI_COMPAT_BASE_URL="https://api.groq.com/openai/v1"
#   OPENAI_COMPAT_API_KEY="gsk_..."
#   AI_MODEL="llama-3.3-70b-versatile"
# Lưu ý: key nằm trong .env (không commit); đổi lại AI_RUNTIME="auto" để
# quay về chế độ 100% local bất cứ lúc nào.
# AI_ALLOW_REMOTE="false"
# OPENAI_COMPAT_API_KEY=""

# ── Hệ AI nâng cao (RAG + Training + Model registry) ──
# AI_EMBEDDING_MODEL="nomic-embed-text"   # model nhúng vector cho RAG (ollama pull)
# Khai báo 1 model trực tiếp theo spec (thêm vào /api/models registry):
# MODEL_PATH="/duong/dan/model.gguf"
# MODEL_TYPE="causal_lm"                  # causal_lm | embedding
# MODEL_FORMAT="gguf"                     # gguf | transformers | gptq | awq | bnb
# CONTEXT_LENGTH="8192"

# AUTH_SECRET — khoá ký session (đã có mặc định dev; đặt giá trị ngẫu nhiên dài ở production)
# AUTH_SECRET="generate-a-long-random-string"

# ── Email (reset mật khẩu) ────────────────────────────
# "dev"  (mặc định): log console + ghi email-outbox.log, KHÔNG gửi thật
# "resend": gửi email thật qua Resend — cần RESEND_API_KEY
EMAIL_PROVIDER="dev"
# RESEND_API_KEY=""
# EMAIL_FROM="KhanhOS AI <noreply@yourdomain.com>"

# ── Owner seed (bun run db:seed-owner) ───────────────
# Chỉ dùng khi seed lại tài khoản owner (idempotent). Production nên đổi hết!
# Email này ĐĂNG KÝ qua form cũng tự nhận role owner (src/lib/auth/owner.ts).
# Hỗ trợ NHIỀU email cách nhau bằng dấu phẩy (mặc định gộp cả hai cách viết
# hoang…/haong… của email chủ sở hữu — mỗi email seed một tài khoản owner).
# OWNER_EMAIL="hoangbaokhanhhehe@gmail.com,haongbaokhanhhehe@gmail.com"
# OWNER_PASSWORD="khanh0712014@#"
# OWNER_NAME="Khanh"

# ── Thanh toán gói dịch vụ (Free/Plus/VIP/Max) ────────
# Chủ TK + STK hiển thị trong form nâng cấp (mặc định: HOANG BAO KHANH / 000000).
# ĐỔI NGAY KHI CÓ STK THẬT — không cần sửa code.
# PAYMENT_ACCOUNT_NAME="HOANG BAO KHANH"
# PAYMENT_ACCOUNT_NUMBER="000000"

# ── Tuỳ chọn sản xuất ─────────────────────────────────
# Cookie secure theo HTTPS (tự động khi NODE_ENV=production)
# FORCE_INSECURE_COOKIE="1"  # chỉ dùng khi preview qua http
